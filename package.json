{
  "name": "trench-hammer-army-builder",
  "version": "2.0.2",
  "description": "Army builder for the Trench Hammer wargame - combining Trench Crusade mechanics with Warhammer 40K universe",
  "type": "module",
  "homepage": "https://afonsobe.github.io/trench-hammer",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "qa:scan": "node scripts/qa_scan.mjs",
    "i18n:check": "node scripts/i18n_check.mjs"
  },
  "keywords": [
    "wargame",
    "army-builder",
    "trench-hammer",
    "trench-crusade",
    "40k"
  ],
  "author": "Vazsago",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "puppeteer": "^24.42.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "i18next": "^27.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^18.0.1"
  }
}
